@echo off
echo Uninstalling CopyLinktoClipboard from the registry...

REM Remove from RegisteredApplications
reg delete "HKLM\SOFTWARE\RegisteredApplications" /v "CopyLinktoClipboard" /f

REM Remove Capabilities
reg delete "HKLM\SOFTWARE\CopyLinktoClipboard" /f

REM Remove URL Handler
reg delete "HKLM\Software\Classes\CopyLinktoClipboardURL" /f

echo done.
pause
